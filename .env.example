NODE_ENV=production
PORT=3000
DB_HOST=mysql
DB_USER=railway
DB_PASSWORD=password
DB_NAME=revionix
DB_PORT=3306

# Clave para firmar los tokens de sesión (JWT). OBLIGATORIA en producción.
# Generar una nueva con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Orígenes permitidos para CORS, separados por coma
ALLOWED_ORIGINS=https://revionix.pe,http://localhost:3000

# Contraseña del usuario admin inicial. Solo se usa si la tabla `usuarios`
# está vacía (instalación desde cero o base restaurada). Si no se define, no
# se siembra ningún usuario — nunca hay contraseñas por defecto en el código.
SEED_ADMIN_PASSWORD=
